# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Google Sheets output (optional). Use ONE of the two options below.
# Option A (recommended for hosting): the whole service-account key JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B (local only): path to the service-account key file. Never commit that file.
GOOGLE_APPLICATION_CREDENTIALS_PATH=

# Set to true to use canned sample data instead of fetching real sites
AUDIT_MOCK_SCAN=false
